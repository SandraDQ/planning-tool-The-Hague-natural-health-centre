# Copy to .env and fill in. Never commit .env.
# Wix (read-only, site-scoped; revoke after migration)
WIX_API_KEY=
WIX_ACCOUNT_ID=
WIX_SITE_ID=
# Database (Supabase, EU region)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Payments (test key until go-live)
MOLLIE_API_KEY=
# Accounting
MONEYBIRD_TOKEN=
# Transactional email (src/lib/email). Without EMAIL_API_KEY nothing is sent: e-mails go to
# the outbox in the admin portal (Admin > E-mails). EMAIL_API_KEY does not block demo mode:
# in the demo, real e-mail only goes to the addresses in EMAIL_DEMO_RECIPIENTS.
EMAIL_PROVIDER=brevo
EMAIL_API_KEY=
EMAIL_FROM="The Hague Natural Health Centre <bookings@thehague-naturalhealthcentre.com>"
# Comma-separated, e.g. your own address, to receive demo e-mails for real.
EMAIL_DEMO_RECIPIENTS=
# Calendar sync
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Demo mode (D28): set DEMO_MODE=1 to run the demo with fake data. Off unless set (`next dev`
# defaults it to 1). The server refuses DEMO_MODE=1 while any real key below is set.
DEMO_MODE=
# Secret for the demo sign-in cookie, 32+ characters (required when DEMO_MODE=1 in production).
# Set it on any shared deployment so sessions survive restarts and work across instances.
DEMO_SESSION_SECRET=
